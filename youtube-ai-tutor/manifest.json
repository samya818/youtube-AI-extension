{
  "manifest_version": 3,
  "name": "YouTube AI Tutor",
  "version": "1.1.6",
  "description": "Pose des questions sur n'importe quel moment d'une vidéo YouTube avec l'aide de l'IA",
  "author": "Samya Loukili",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "sidePanel",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube-transcript.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_title": "YouTube AI Tutor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "lib/utils.js",
        "content/capture.js",
        "content/overlay.js",
        "content/annotation-editor.js",
        "content/annotation-panel.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page-script.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
