{
  "manifest_version": 3,
  "name": "ClarifyTube — AI Study Tutor for YouTube",
  "version": "1.1.6",
  "description": "Clarify any moment in YouTube lectures with interactive AI, visual annotations, and smart revision notes.",
  "author": "Samya Loukili",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "webNavigation",
    "sidePanel",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube-transcript.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.mistral.ai/*",
    "https://openrouter.ai/*",
    "https://mbwapniarmmouuuyhkyf.supabase.co/*"
  ],
  "action": {
    "default_title": "ClarifyTube",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background/service-worker.js"],
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "lib/utils.js",
        "content/capture.js",
        "content/annotation-editor.js",
        "content/annotation-panel.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page-script.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clarifytube@samya818.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
